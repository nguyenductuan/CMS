    <insert id="insertproduct" parameterType="com.vt.cms.model.entity.Product"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO products (
            name,
            description,
            status,
            created_at,
            created_by,
            json_images,
            json_medias,
            json_attributes,
            json_attributes_name,
            type_products,
            type_products_name,
            is_deleted
        )
        VALUES (
                   #{name},
                #{description},
                #{status},
                #{created_at},
                #{created_by},
                #{json_images},
                #{json_medias},
                #{json_attributes},
                #{json_attributes_name},
                #{type_products},
                #{type_products_name},
                #{is_deleted}
               )
    </insert>

