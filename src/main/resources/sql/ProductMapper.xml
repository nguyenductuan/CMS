    <update id="editstatusproduct" parameterType="com.vt.cms.model.entity.Product">
        UPDATE products
        SET status     = #{status},
            updated_at = #{updated_at},
            approved_time= #{approved_time},
            approve_by = #{approve_by}
        WHERE id = #{id}
    </update>

    <update id="deleteproduct" parameterType="com.vt.cms.model.entity.Product">
        UPDATE products
        SET is_deleted = 'true'
        WHERE id = #{id}
    </update>


</mapper>