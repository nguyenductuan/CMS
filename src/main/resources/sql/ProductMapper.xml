<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.ProductRepository">
    <resultMap id="ProductResultMap" type="com.vt.cms.model.entity.Product">
        <id column="id" property="id" jdbcType="INTEGER"/>

        <result column="name" property="name" jdbcType="VARCHAR"/>


        <result column="created_at" property="created_at" jdbcType="TIMESTAMP"/>
        <result column="created_by" property="created_by" jdbcType="VARCHAR"/>

        <result column="is_deleted" property="is_deleted" jdbcType="VARCHAR"/>

        <result column="updated_at" property="updated_at" jdbcType="TIMESTAMP"/>
        <result column="updated_by" property="updated_by" jdbcType="VARCHAR"/>

        <result column="description" property="description" jdbcType="VARCHAR"/>

        <result column="json_images" property="json_images" jdbcType="OTHER"/>
        <result column="json_attributes" property="json_attributes" jdbcType="OTHER"/>
        <result column="json_medias" property="json_medias" jdbcType="OTHER"/>

        <result column="price_display" property="price_display" jdbcType="INTEGER"/>

        <result column="status" property="status" jdbcType="VARCHAR"/>

        <result column="json_attributes_name" property="json_attributes_name" jdbcType="VARCHAR"/>

        <result column="type_products_name" property="type_products_name" jdbcType="VARCHAR"/>

        <result column="type_products" property="type_products" jdbcType="OTHER"/>

        <result column="cancel_at" property="cancel_at" jdbcType="VARCHAR"/>
        <result column="cancel_by" property="cancel_by" jdbcType="VARCHAR"/>

        <result column="approve_by" property="approve_by" jdbcType="VARCHAR"/>
        <result column="approved_time" property="approved_time" jdbcType="TIMESTAMP"/>
    </resultMap>

