<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.ProductRepository">
    <resultMap id="ProductResultMap" type="com.vt.cms.model.entity.ProductDetail">

        <!-- Product -->
        <id column="id"
            property="id"
            jdbcType="VARCHAR"/>

        <result column="campaign_id"
                property="campaignId"
                jdbcType="INTEGER"/>

        <result column="name"
                property="name"
                jdbcType="VARCHAR"/>

        <result column="price_campaign"
                property="priceCampaign"
                jdbcType="DECIMAL"/>

        <result column="price_discount_campaign"
                property="priceDiscountCampaign"
                jdbcType="DECIMAL"/>

        <result column="description"
                property="description"
                jdbcType="VARCHAR"/>

        <result column="status"
                property="status"
                jdbcType="VARCHAR"/>

        <result column="create_at"
                property="createAt"
                jdbcType="TIMESTAMP"/>

        <result column="update_at"
                property="updateAt"
                jdbcType="TIMESTAMP"/>

        <result column="approved_time"
                property="approvedTime"
                jdbcType="TIMESTAMP"/>


        <!-- Campaign -->
        <result column="campaign_status"
                property="campaignStatus"
                jdbcType="VARCHAR"/>

        <result column="sales_commission"
                property="salesCommission"
                jdbcType="DECIMAL"/>

        <result column="product_commission"
                property="productCommission"
                jdbcType="DECIMAL"/>

        <result column="campaign_start_at"
                property="campaignStartAt"
                jdbcType="TIMESTAMP"/>

        <result column="campaign_end_at"
                property="campaignEndAt"
                jdbcType="TIMESTAMP"/>


        <!-- Product attributes -->
        <result column="json_attributes_name"
                property="attributesName"
                jdbcType="VARCHAR"/>

        <result column="type_products_name"
                property="typeProductsName"
                jdbcType="VARCHAR"/>


        <!-- SKU JSON -> List<SkuResponse> -->
        <result column="skus"
                property="skus"
                typeHandler="com.vt.cms.config.SkuListTypeHandler"/>


        <!-- Statistics -->
        <result column="total_sold"
                property="totalSold"
                jdbcType="INTEGER"/>

        <result column="rating_avg"
                property="ratingAvg"
                jdbcType="DECIMAL"/>

    </resultMap>

    <select id="getproduct1" resultMap="ProductResultMap">

        SELECT
            /* =========================
               PRODUCT
               ========================= */

            p.id                   AS id,

            c.id                   AS campaign_id,

            p.name                 AS name,

            p.json_medias          AS json_medias,

            p.json_images          AS json_images,

            p.json_attributes      AS json_attributes,

            p.json_attributes_name AS json_attributes_name,

            p.type_products        AS type_products,

            p.type_products_name   AS type_products_name,

            p.description          AS description,

            p.status               AS status,

            p.created_at           AS create_at,

            p.updated_at           AS update_at,
            /* =========================
               CAMPAIGN
               ========================= */

            c.status               AS campaign_status,

            c.start_time           AS campaign_start_at,

            c.end_time             AS campaign_end_at,
            /* =========================
               SKU
               ========================= */
            COALESCE(
                    (
                        SELECT CONCAT(
                                       '[',
                                       GROUP_CONCAT(
                                               JSON_OBJECT(
                                                       'id', ps.id,
                                                       'sku_code', ps.sku_code,
                                                       'attribute', ps.attribute,
                                                       'type_product', ps.type_product,
                                                       'price', ps.price,
                                                       'stock', ps.stock,
                                                       'weight_gram', ps.weight_gram,
                                                       'length_cm', ps.length_cm,
                                                       'width_cm', ps.width_cm,
                                                       'height_cm', ps.height_cm,
                                                       'image_url', ps.image_url,
                                                       'status', ps.status,
                                                       'campaign_product_status', cp2.status,
                                                       'price_campaign', cp2.price,
                                                       'price_discount_campaign', cp2.price_discount,
                                                       'stock_campaign', cp2.stock_campaign
                                               )
                                               ORDER BY ps.id
                                               SEPARATOR ','
                                       ),
                                       ']'
                               )
                        FROM campain_product cp2
                                 INNER JOIN product_sku ps
                                            ON ps.id = cp2.sku_id
                                                AND ps.product_id = cp2.product_id
                        WHERE cp2.campaign_id = c.id
                          AND cp2.product_id = p.id
                          AND cp2.is_deleted = 'false'
                          AND ps.is_deleted = 'false'
                    ),
                    '[]'
            ) AS skus
        FROM campaign c

                 INNER JOIN products p
                            ON p.id = #{product_id}
#                                 AND p.is_deleted = 'false'

        WHERE c.id = #{campaign_id} ;
#           and c.status='APPROVAL';

    </select>


    <select id="detailProduct" resultMap="ProductResultMap">
        SELECT *
        FROM products
        WHERE id = #{id}
    </select>

    <select id="listproduct" resultMap="ProductResultMap">
        SELECT *
        FROM products
        LIMIT #{pageSize}
    </select>
    <select id="countproduct">
        SELECT COUNT(id)
        FROM products
    </select>
    <insert id="insertproduct" parameterType="com.vt.cms.model.entity.Product"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO products (name,
                              description,
                              status,
                              created_at,
                              created_by,
                              json_images,
                              json_medias,
                              json_attributes,
                              json_attributes_name,
                              type_products,
                              type_products_name,
                              is_deleted)
        VALUES (#{name},
                #{description},
                #{status},
                #{created_at},
                #{created_by},
                #{json_images},
                #{json_medias},
                #{json_attributes},
                #{json_attributes_name},
                #{type_products},
                #{type_products_name},
                #{is_deleted})
    </insert>

