    <insert id="insertorderitems" parameterType="com.vt.cms.model.entity.OrderItem">
        INSERT INTO order_item (
        order_id,
        quantity,
        product_id,
        price,
        total_price,
        sku_id
        )
        VALUES
            <foreach collection="list" item="item" separator=",">
            (
            #{item.order_id},
            #{item.quantity},
            #{item.product_id},
            #{item.price},
            #{item.total_price},
            #{item.sku_id}
            )
        </foreach>
    </insert>

</mapper>