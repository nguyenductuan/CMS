<mapper namespace="com.vt.cms.order.domain.repository.OrderItemRepository">
    <resultMap id="OrderItemResultMap" type="com.vt.cms.order.domain.entity.OrderItem">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="quantity" property="quantity" jdbcType="OTHER"/>
        <result column="order_id" property="order_id" jdbcType="OTHER"/>
        <result column="sku_id" property="sku_id" jdbcType="OTHER"/>
        <result column="campaign_id" property="campaign_id" jdbcType="OTHER"/>
        <result column="price" property="price" jdbcType="OTHER"/>
        <result column="product_id" property="product_id" jdbcType="OTHER"/>
        <result column="total_price" property="total_price" jdbcType="OTHER"/>

    </resultMap>

    <insert id="saveAll" parameterType="com.vt.cms.order.domain.entity.OrderItem" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO order_item (
        order_id,
        quantity,
        unitPrice,
        originalPrice,
        total_price,
        sku_id,
        totalweight
        )
        VALUES
        <foreach collection="orderItems" item="item" separator=",">
            (
            #{item.order_id},
            #{item.quantity},
            #{item.unitPrice},
            #{item.originalPrice},
            #{item.total_price},
            #{item.sku_id},
            #{item.totalWeight}
            )
        </foreach>
    </insert>
    <select id="findorderitem"
            resultType="com.vt.cms.order.application.dto.response.OrderItemDto">
        SELECT DISTINCT
        o.id AS orderId,
        ps.id AS skuId,
        ps.sku_code AS skuCode,
        ot.quantity AS quantity,
        ps. attribute AS attribute,
        ps.status AS status,
        ps.type_product AS typeProducts,
        ps.height_cm AS heightCm,
        ps.length_cm AS lengthCm,
        ps.weight_gram AS weightGram,
        ps. width_cm AS weightCm
        FROM order_item ot 
INNER JOIN orders o
    ON ot.order_id = o.id
INNER JOIN products p
    ON o.product_id = p.id
INNER JOIN product_sku ps
    ON ot.sku_id = ps.id
INNER JOIN campain_product cp
    ON ps.id = cp.sku_id

        WHERE o.is_deleted = 'false'
        AND EXISTS (
        SELECT 1
        FROM campain_product cp
        WHERE cp.sku_id = ps.id
        )
        AND o.id IN
        <foreach collection="orderIds" item="item" open="("
                 separator=","
                 close=")">
            #{item}
        </foreach>

    </select>

