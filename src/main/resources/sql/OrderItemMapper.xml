<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.OrderItemRepository">
    <resultMap id="OrderItemResultMap" type="com.vt.cms.model.entity.OrderItem">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="quantity" property="quantity" jdbcType="OTHER"/>
        <result column="order_id" property="orderId" jdbcType="OTHER"/>
        <result column="price" property="price" jdbcType="OTHER"/>
        <result column="product_id" property="productId" jdbcType="OTHER"/>

    </resultMap>

    <insert id="insertorderCartItem" parameterType="com.vt.cms.model.entity.OrderItem">
        INSERT INTO order_item (product_id, order_id, quantity, price)
        VALUES (#{productId},
                #{orderId},
                #{quantity},
                #{price})
    </insert>

</mapper>