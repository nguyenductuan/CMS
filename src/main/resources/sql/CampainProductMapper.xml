<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.campain.domain.repository.CampainProductRepository">

    <!-- Ánh xạ kết quả từ DB sang entity -->
    <resultMap id="CampainProductResultMap" type="com.vt.cms.campain.domain.enity.CampainProduct">
        <id property="id" column="id"/>

        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="campaignId" column="campaign_id"/>
        <result property="productId" column="product_id"/>
        <result property="skuId" column="sku_id"/>
        <result property="stockCampaign" column="stock_campaign"/>
        <result property="price" column="price"/>
        <result property="price_discount" column="price_discount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- Lệnh insert -->
    <insert id="savecampainproduct" parameterType="com.vt.cms.campain.domain.enity.CampainProduct"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO campain_product (created_at,
                                     created_by,
                                     is_deleted,
                                     updated_at,
                                     updated_by,
                                     campaign_id,
                                     product_id,
                                     sku_id,
                                     stock_campaign,
                                     price,
                                     price_discount,
                                     discount_amount,
                                     status)
        VALUES (#{createdAt},
                #{createdBy},
                #{isDeleted},
                #{updatedAt},
                #{updatedBy},
                #{campaignId},
                #{productId},
                #{skuId},
                #{stockCampaign},
                #{price},
                #{price_discount},
                #{discountAmount},
                #{status})
    </insert>

    <select id="existsAssociationByProductId" resultType="boolean">
        SELECT EXISTS (SELECT 1
                       FROM campain_product
                       WHERE product_id = #{productId})
    </select>

    <update id="deductStock">
        UPDATE campain_product
        SET stock_campaign = stock_campaign - #{quantity}
        WHERE campaign_id = #{campainId}
          AND sku_id = #{SkuId}
          AND stock_campaign >= #{quantity};
    </update>

    <select id="findCampainProductById"
            resultType="com.vt.cms.campain.application.dto.response.CampaignProductResponse">
        SELECT cp.id              as id,
               cp.campaign_id     as campaignId,
               cp.product_id      as productId,
               cp.sku_id          as skuId,
               ps.attribute       as attribute,
               ps.type_product    as typeProduct,
               p.name             as productName,
               ps.price           as price,
               cp.price_discount  as disCountPrice,
               cp.stock_campaign  as stockCampaign,
               ps.image_url       as imageUrlSku,
               cp.discount_amount as discountAmount,
               cp.status          as status,
               cp.price           as priceCampaign,
               p.json_images      as productImage,
               CASE
                   WHEN ps.price IS NULL OR ps.price = 0 THEN 0
                   ELSE ROUND(
                           (1 - (cp.price_discount / ps.price)) * 100,
                           2
                        )
                   END            AS discount
        FROM campain_product cp
                 JOIN product_sku ps ON ps.id = cp.sku_id
                 JOIN products p ON p.id = cp.product_id
        WHERE cp.campaign_id = #{campaign_id}
          AND cp.is_deleted = false
    </select>

    <select id="findCampaignProductByCampaignIdIn"
            parameterType="java.util.Set"
            resultType="com.vt.cms.campain.domain.enity.CampainProduct">
        SELECT *
        FROM campain_product
        WHERE campaign_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findAllByCampaignIds"
            parameterType="java.util.Set"
            resultType="com.vt.cms.campain.domain.enity.CampainProduct">
        SELECT *
        FROM campain_product
        WHERE campaign_id IN
        <foreach collection="campaignIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
