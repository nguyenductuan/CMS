<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.order.domain.repository.OrderActionLogRepository">
    <resultMap id="OrderActionLog" type="com.vt.cms.order.domain.entity.OrderActionLog">
        <id column="id" property="id"/>
        <result column="order_id" property="order_id"/>
        <result column="action" property="action"/>
        <result column="role_action" property="role_action"/>
        <result column="description" property="description"/>

    </resultMap>
    <insert id="saveorder" parameterType="com.vt.cms.order.domain.entity.OrderActionLog">
        INSERT INTO order_action_log (order_id,
                                      action,
                                      role_action,
                                      description)
        VALUES (#{order_id},
                #{action},
                #{role_action},
                #{description})
    </insert>
</mapper>