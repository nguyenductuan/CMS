<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.CartRepository">

    <resultMap id="CartResultMap" type="com.vt.cms.model.entity.Cart">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
    </resultMap>

    <insert id="insertCart"
            parameterType="com.vt.cms.model.entity.Cart"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO cart (user_id)
        VALUES (#{userId})
    </insert>

    <select id="finByUserId" resultMap="CartResultMap">
        SELECT id, user_id
        FROM cart
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
