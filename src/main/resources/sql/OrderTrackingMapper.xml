<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.order.domain.repository.OrderTrackingRepository">
    <resultMap id="OrderHistoryMap" type="com.vt.cms.order.domain.entity.OrderTracking">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="order_id" property="orderId" jdbcType="OTHER"/>
        <result column="status_code" property="statusCode"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="actor" property="actor"/>
        <result column="actor_role" property="actorRole"/>
        <result column="event_code" property="eventCode"/>
        <result column="created_at" property="createdAt"/>

    </resultMap>
    <insert id="saveAll" parameterType="java.util.List">
        INSERT INTO order_tracking (
        order_id,
        order_tracking_status,
        buyer_msg,
        created_at
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.orderId},
            #{item.orderTrackingStatus},
            #{item.buyerMsg},
            NOW()
            )
        </foreach>
    </insert>

    <insert id="createtracking" parameterType="java.util.List">
        INSERT INTO order_tracking (
        order_id,
        order_tracking_status,
        buyer_msg,
        created_at
        )
        VALUES
        <foreach collection="orderIds" item="item" separator=",">
            (
            #{item.orderId},
            #{item.orderTrackingStatus},
            #{item.buyerMsg},
            NOW()
            )
        </foreach>
    </insert>

</mapper>
