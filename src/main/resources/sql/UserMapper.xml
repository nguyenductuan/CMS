<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.UserRepository">
        <resultMap id="UserResultMap" type="com.vt.cms.model.entity.User">
            <id column="id" property="id" jdbcType="OTHER"/>
            <result column="name" property="name" jdbcType="VARCHAR"/>
            <result column="age" property="age" jdbcType="INTEGER"/>
        </resultMap>

    <select id="getUser" resultMap="UserResultMap">
        SELECT * FROM user
    </select>

    <select id="detailUser" resultMap="UserResultMap">
        SELECT * FROM user where id = #{id}
    </select>

    </mapper>