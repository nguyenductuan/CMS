<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.UserRepository">
    <resultMap id="UserResultMap" type="com.vt.cms.model.entity.User">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="address" property="address"/>
        <result column="bank_name" property="bankName"/>
        <result column="bank_account_number" property="bankAccountNumber"/>
        <result column="bank_account_holder" property="bankAccountHolder"/>
    </resultMap>

    <select id="getUser" resultMap="UserResultMap">
        SELECT id, name, age, username, role FROM user
    </select>

    <select id="detailUser" resultMap="UserResultMap">
        SELECT id, name, age, username, role FROM user WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT id, name, age, username, password, role
        FROM user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <insert id="createUser" parameterType="com.vt.cms.model.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (name, age, username, password, role)
        VALUES (#{name}, #{age}, #{username}, #{password}, #{role})
    </insert>
    <update id="updateBuyerProfile" parameterType="com.vt.cms.model.entity.User">
        UPDATE user SET name=#{name}, age=#{age}, phone=#{phone}, email=#{email}, address=#{address},
            bank_name=#{bankName}, bank_account_number=#{bankAccountNumber}, bank_account_holder=#{bankAccountHolder}
        WHERE id=#{id} AND role='BUYER'
    </update>
</mapper>
