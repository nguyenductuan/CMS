<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vt.cms.model.repository.CartItemRepository">
    <resultMap id="CartItemResultMap" type="com.vt.cms.model.entity.CartItem">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="cart_id" property="cartId" jdbcType="VARCHAR"/>
        <result column="product_id" property="productId" jdbcType="INTEGER"/>
        <result column="quantity" property="quantity" jdbcType="VARCHAR"/>
        <result column="product_name" property="productName" jdbcType="VARCHAR"/>
        <result column="product_price" property="productPrice" jdbcType="INTEGER"/>
    </resultMap>

    <insert id="insertCartItem">
        INSERT INTO cart_item (cart_id,
                               product_id,
                               quantity,
                               product_name,
                               product_price)
        VALUES (#{cartId},
                #{productId},
                #{quantity},
                #{productName},
                #{productPrice})
    </insert>

    <select id="findByProductIDAndCart" resultMap="CartItemResultMap">
        SELECT id,
               cart_id,
               product_id,
               product_name,
               product_price,
               quantity
        FROM cart_item
        WHERE product_id = #{productId}
          AND cart_id = #{cartId} LIMIT 1
    </select>
    <select id="finByCartId" resultMap="CartItemResultMap">
        SELECT *
        FROM cart_item
        where cart_id = #{cartId}
    </select>

    <update id="updateCartItem">
        UPDATE cart_item
        SET quantity      = #{quantity},
            product_name  = #{productName},
            product_price = #{productPrice}
        WHERE id = #{id}
    </update>
    <delete id="deleteproductCart">
        DELETE FROM cart_item
        WHERE cart_id = #{cartId}
        AND product_id IN
        <foreach item="id" collection="productIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>